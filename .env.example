# ============================================================================
# Binance Alpha Event Monitor — environment template (Phase 2)
# Copy to `.env` and fill in the values. NEVER commit `.env` to git.
# ============================================================================

# --- general ---
APP_ENV=production
TIMEZONE=Asia/Shanghai

# --- official sources (explicit allowlist) --------------------------------
# Only official Binance channels are allowed. Keys are matched against the
# built-in builders; anything else is ignored. Third-party feeds are never
# part of production monitoring.
SOURCES_ALLOWLIST=telegram_wallet,binance_square,telegram_announcements

# --- P0: Binance Wallet official Telegram (public web preview) ------------
TELEGRAM_SOURCE_ENABLED=true
TELEGRAM_CHANNEL=binance_wallet_announcements
TELEGRAM_FETCH_TIMEOUT=15
TELEGRAM_MAX_RETRIES=2
# TELEGRAM_FIXTURE=tests/fixtures/binance_wallet_announcements.txt  # offline/sandbox only

# --- P1: Binance official English announcements Telegram (supplementary) --
TELEGRAM_ANNOUNCEMENTS_ENABLED=true
TELEGRAM_ANNOUNCEMENTS_CHANNEL=binance_announcements
# TELEGRAM_ANNOUNCEMENTS_FIXTURE=tests/fixtures/binance_announcements.txt

# --- Binance Square official account (Binance Wallet) ---------------------
# Binance Square has NO public API; /bapi/composite/* needs front-end
# fingerprint headers and robots.txt disallows automated access, so v1 keeps
# the adapter in BLOCKED mode by default (honest SOURCE_BLOCKED, no fake PASS).
# If you later capture a valid header set on the production box you may try:
#   SQUARE_MODE=attempt
#   SQUARE_EXTRA_HEADERS={"bnc-uuid":"...","csrftoken":"..."}
# Offline pipeline tests: SQUARE_MODE=fixture + SQUARE_FIXTURE=<json envelope>
SQUARE_ENABLED=true
SQUARE_PROFILE=binancewallet
SQUARE_API_BASE=https://www.binance.com
SQUARE_MODE=blocked
# SQUARE_FIXTURE=
SQUARE_EXTRA_HEADERS=
SQUARE_TIMEOUT=15
SQUARE_MAX_RETRIES=1

# --- dynamic polling (seconds) ---
POLL_INTERVAL_IDLE_SECONDS=1800
POLL_INTERVAL_UPCOMING_SECONDS=900
POLL_INTERVAL_NEAR_EVENT_SECONDS=300
POLL_INTERVAL_COUNTDOWN_SECONDS=60
# random ±10% jitter on the global wait; 0–3s stagger between sources
POLL_JITTER_FRACTION=0.1
SOURCE_STAGGER_MAX_SECONDS=3

# --- T-10 reminder ---
REMINDER_MINUTES_BEFORE_START=10
# reminder scheduler tick is INDEPENDENT of the poll interval (30–60s)
REMINDER_TICK_SECONDS=30
REMINDER_FIRE_GRACE_SECONDS=90
AIRDROP_WINDOW_HOURS=2

# --- PushPlus WeChat (register at https://www.pushplus.plus, get a token) ---
# With the token empty the monitor still runs and logs "[DRY-RUN] ..."
PUSHPLUS_ENABLED=false
PUSHPLUS_TOKEN=
# PUSHPLUS_API_URL=https://www.pushplus.plus/send

# --- storage / health ---
# DB_PATH=/app/data/monitor.db
# HEALTH_PATH=/app/data/health.json
# (health verdicts are now interval-aware per source; the two legacy
#  HEALTH_FETCH_*_MINUTES knobs below are kept for compatibility)
HEALTH_FETCH_WARNING_MINUTES=10
HEALTH_FETCH_ERROR_MINUTES=30
